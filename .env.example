# ---- LLM provider ----
# One of: openai, anthropic, mistral
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5

MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-large-latest

# ---- Search providers ----
# Tavily is optional but recommended (higher quality web search).
# DuckDuckGo and Wikipedia and arXiv require no API key.
TAVILY_API_KEY=

# ---- App behaviour ----
MAX_SEARCH_RESULTS_PER_SOURCE=5
MAX_PAGES_TO_SCRAPE=8
SEARCH_CACHE_TTL_SECONDS=3600
RELEVANCE_SCORE_THRESHOLD=0.45
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# ---- Storage ----
DATABASE_PATH=data/db/research_agent.sqlite3
REPORTS_DIR=data/reports
